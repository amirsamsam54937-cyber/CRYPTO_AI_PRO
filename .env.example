# CRYPTO AI PRO — safe defaults
APP_NAME=CRYPTO AI PRO
EXCHANGE_ID=xt
DEFAULT_SYMBOL=BTC/USDT:USDT
DEFAULT_TIMEFRAME=1h

# XT credentials belong ONLY in the server's secret manager/environment.
# Never paste keys into chat, source files, notebooks, APKs, or Git commits.
XT_API_KEY=
XT_SECRET_KEY=

# Live execution remains OFF until all readiness gates are validated.
LIVE_TRADING_ENABLED=false
PAPER_TRADING_ENABLED=true

# Conservative initial risk policy (not a profit guarantee).
RISK_PER_TRADE=0.005
MAX_RISK_PER_TRADE=0.01
MAX_PORTFOLIO_RISK=0.03
MAX_LEVERAGE=3
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS=0.02
MAX_DAILY_ORDERS=10
